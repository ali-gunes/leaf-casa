http://leaf.casa, https://leaf.casa, http://www.leaf.casa, https://www.leaf.casa {
    encode gzip

    @www host www.leaf.casa
    handle @www {
        redir http://leaf.casa{uri} 301
    }

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    reverse_proxy leaf-casa:3000 {
        flush_interval -1
        header_up Host {host}
        header_up X-Real-IP {remote_host}
    }
}
