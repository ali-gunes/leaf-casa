# Branding & Public URL
PUBLIC_APP_NAME=Leaf Casa
PUBLIC_BASE_URL=https://leaf.casa
PUBLIC_GITHUB_URL=https://github.com/ali-gunes/leaf-casa

# Server
PORT=3000
HOST=0.0.0.0

# Limits
MAX_FILE_SIZE_MB=100
MAX_MEMORY_POOL_MB=512
SESSION_TTL_MINUTES=15

# Analytics & Dashboard (/stats)
DB_PATH=./data/stats.db
STATS_USER=admin
STATS_PASSWORD=change-me-in-production
LOG_RAW_IP=true
